# Sunucu
PORT=3020
HOST=127.0.0.1

# Dışarıdan görünen adres (çerez ve CSRF denetimi bunu kullanır)
PUBLIC_ORIGIN=https://ornek.org

# Alt dizin kurulumu (ör. ornek.org/eyouthpreneur). Vekil öneki soyup köke iletir.
# BASE_PATH=/eyouthpreneur

# HTTPS arkasında çalışırken oturum çerezi yalnızca güvenli bağlantıda gönderilsin
COOKIE_SECURE=true

# Ters vekil arkasındaysa istemci adresi X-Forwarded-For'dan okunur
TRUST_PROXY=true

# PostgreSQL kullanmak için. Tanımsızsa data/ altında SQlite dosyası kullanılır.
# DATABASE_URL=postgres://kullanici:parola@localhost:5432/eyouthpreneur

# SQLite dosyasının dizini
DATA_DIR=./data
